{
  "name": "eco-auditor",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "vite",
    "build": "node scripts/check-legal-placeholders.mjs && tsc -b && vite build && node scripts/prerender.mjs",
    "build:skip-legal": "tsc -b && vite build && node scripts/prerender.mjs",
    "lint": "eslint .",
    "preview": "vite preview",
    "start": "node server.cjs",
    "db:migrate": "npx @insforge/cli db migrations up --all",
    "db:migrate:status": "npx @insforge/cli db migrations list",
    "db:migrate:check": "node scripts/check-migrations.mjs",
    "db:migrate:new": "npx @insforge/cli db migrations new",
    "security:audit": "node scripts/audit-production.mjs",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "tailwindcss": "3.4",
    "stripe": "^22.0.1",
    "@insforge/sdk": "^1.2.4",
    "autoprefixer": "^10.4.27",
    "recharts": "^3.8.1",
    "express": "^4.22.1",
    "pg": "^8.20.0",
    "postcss": "8.5.24",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-router-dom": "^7.18.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@types/node": "^24.12.2",
    "@types/pg": "^8.20.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "eslint": "^9.39.4",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.4.0",
    "jsdom": "^29.0.2",
    "proxy-addr": "~2.0.7",
    "tsx": "^4.21.0",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.58.0",
    "vite": "^8.0.4",
    "vitest": "^4.1.4"
  },
  "overrides": {
    "@esbuild-kit/core-utils": {
      "esbuild": "0.28.1"
    },
    "body-parser": "1.20.6",
    "browserslist": "4.28.8",
    "qs": "6.16.0",
    "esbuild": "0.28.1",
    "nanoid": "3.3.18",
    "socket.io-parser": "4.2.7",
    "ws": "8.21.1",
    "eslint": {
      "brace-expansion": "1.1.18"
    }
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
