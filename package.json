{
  "name": "eco-auditor",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "vite",
    "build": "node scripts/check-legal-placeholders.mjs && tsc -b && vite build && node scripts/prerender.mjs",
    "build:skip-legal": "tsc -b && vite build && node scripts/prerender.mjs",
    "lint": "eslint .",
    "preview": "vite preview",
    "start": "node server.cjs",
    "db:migrate": "npx @insforge/cli db migrations up --all",
    "db:migrate:status": "npx @insforge/cli db migrations list",
    "db:migrate:check": "node scripts/check-migrations.mjs",
    "db:migrate:new": "npx @insforge/cli db migrations new",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@headlessui/react": "^2.2.10",
    "@heroicons/react": "^2.2.0",
    "@insforge/sdk": "^1.2.4",
    "autoprefixer": "^10.4.27",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.2",
    "express": "^4.22.1",
    "pg": "^8.20.0",
    "postcss": "8.5.14",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-router-dom": "^7.14.0",
    "recharts": "^3.8.1",
    "stripe": "^22.0.1",
    "tailwindcss": "3.4"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@types/node": "^24.12.2",
    "@types/pg": "^8.20.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9.39.4",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.4.0",
    "jsdom": "^29.0.2",
    "tsx": "^4.21.0",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.58.0",
    "vite": "^8.0.4",
    "vitest": "^4.1.4"
  },
  "overrides": {
    "@esbuild-kit/core-utils": {
      "esbuild": "0.28.0"
    }
  },
  "pnpm": {
    "onlyBuiltDependencies": ["esbuild"]
  }
}
