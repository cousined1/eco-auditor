   262	      <path d="M16.36 1.43c0 1.1-.4 2.1-1.2 2.99-.86.96-1.9 1.51-3.02 1.42-.14-1.07.42-2.2 1.17-3.08.82-.97 2.18-1.7 3.05-1.33ZM20.2 17.12c-.52 1.19-.77 1.72-1.43 2.77-.93 1.43-2.24 3.22-3.86 3.24-1.44.02-1.81-.94-3.77-.93-1.96.01-2.37.96-3.81.94-1.62-.02-2.86-1.63-3.79-3.06-2.6-4-2.88-8.68-1.27-11.17 1.15-1.77 2.96-2.8 4.66-2.8 1.73 0 2.82.95 4.25.95 1.39 0 2.24-.95 4.24-.95 1.51 0 3.11.82 4.25 2.24-3.73 2.04-3.12 7.37.53 8.77Z" />
