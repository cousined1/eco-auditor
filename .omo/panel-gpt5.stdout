   215	}
   216	function AccessIcon() {
   217	  return <svg className="w-5 h-5" viewBox="0 0 20 20" fill="none" stroke="currentColor" strokeWidth="1.5" strokeLinecap="round" strokeLinejoin="round"><circle cx="10" cy="6" r="3.5" /><path d="M3 18c0-3.5 3-5.5 7-5.5s7 2 7 5.5" /></svg>;
   218	}
   219	function DataIcon() {
   220	  return <svg className="w-5 h-5" viewBox="0 0 20 20" fill="none" stroke="currentColor" strokeWidth="1.5" strokeLinecap="round" strokeLinejoin="round"><path d="M4 4h12v12H4z" /><path d="M8 4v12M4 8h12" /></svg>;
