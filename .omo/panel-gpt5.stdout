   174	                Contact Security Team
   175	              </Link>
   176	              <a href="mailto:hello@developer312.com?subject=Security%20Question" className="inline-flex items-center justify-center px-8 py-3 bg-white/10 hover:bg-white/20 text-white font-medium text-sm rounded-lg transition-colors border border-white/20">
   177	                Email Us
   178	              </a>
   179	            </div>
   180	          </div>
   181	        </div>
   182	      </section>
   183	    </div>
   184	  );
