      { label: 'Primary Source Data (L2)', score: 34, color: 'bg-brand-400' },
      { label: 'Industry Average (L3)', score: 41, color: 'bg-amber-400' },
      { label: 'Proxy / Estimated (L4–L5)', score: 17, color: 'bg-orange-400' },
    ];
    
