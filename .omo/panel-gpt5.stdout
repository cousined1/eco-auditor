    51	      {/* ─── Trust Grid ─── */}
    52	      <section className="max-w-5xl mx-auto px-6 py-12">
    53	        <div className="grid grid-cols-1 md:grid-cols-3 gap-6">
    54	          <TrustCard
    55	            icon={<EncryptionIcon />}
    56	            title="Encryption"
    57	            items={[
