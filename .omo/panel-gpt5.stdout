    83	                <svg className="h-6 w-6 text-accent" fill="none" viewBox="0 0 24 24" strokeWidth={2} stroke="currentColor" aria-hidden="true">
    84	                  <path strokeLinecap="round" strokeLinejoin="round" d="M21.75 6.75v10.5a2.25 2.25 0 0 1-2.25 2.25h-15a2.25 2.25 0 0 1-2.25-2.25V6.75m19.5 0A2.25 2.25 0 0 0 19.5 4.5h-15a2.25 2.25 0 0 0-2.25 2.25m19.5 0v.243a2.25 2.25 0 0 1-1.07 1.916l-7.5 4.615a2.25 2.25 0 0 1-2.36 0L3.32 8.91a2.25 2.25 0 0 1-1.07-1.916V6.75" />
    85	                </svg>
    86	              </div>
    87	              <h1 className="text-lg font-semibold text-surface-900 dark:text-white">Check your email</h1>
    88	              <p className="mt-2 text-sm text-surface-500">
    89	                We sent a verification email to{' '}
    90	                <span className="font-medium text-surface-700 dark:text-surface-300">{email}</span>.
    91	                Click the link in the email to verify your account, then sign in.
    92	              </p>
    93	              <Link
    94	                to="/login"
    95	                className="btn-primary mt-6 inline-flex"
    96	              >
    97	                Go to sign in
    98	              </Link>
    99	            </div>
   100	          </section>
   101	        </main>
   102	      </div>
   103	    );
   104	  }
   105	
   106	  return (
   107	    <div className="min-h-screen bg-surface-50 dark:bg-surface-950 flex flex-col">
   108	      <header className="border-b border-surface-200 dark:border-surface-800 bg-white dark:bg-surface-900">
   109	        <div className="max-w-5xl mx-auto px-6 py-4 flex items-center justify-between">
   110	          <Link to="/" className="flex items-center gap-2 text-sm font-semibold text-surface-900 dark:text-white">
   111	            <EcoMark />
   112	            Eco-Auditor
   113	          </Link>
   114	          <Link to="/pricing" className="text-sm text-surface-500 hover:text-surface-900 dark:hover:text-white">
   115	            Pricing
   116	          </Link>
   117	        </div>
   118	      </header>
   119	
   120	      <main className="flex-1 flex items-center justify-center px-6 py-12">
   121	        <section className="w-full max-w-md">
   122	          <div className="mb-8 text-center">
   123	            <h1 className="text-2xl font-bold text-surface-900 dark:text-white">Start your free trial</h1>
   124	            <p className="mt-2 text-sm text-surface-500">
   125	              No credit card required. 14-day free trial. Set up in under 10 minutes.
   126	            </p>
   127	          </div>
   128	
   129	          <div className="card space-y-3">
   130	            {!isInsForgeConfigured && (
   131	              <div className="rounded-lg border border-amber-200 bg-amber-50 px-3 py-2 text-xs text-amber-800 dark:border-amber-800 dark:bg-amber-950 dark:text-amber-200">
   132	                InsForge is not configured. Set VITE_INSFORGE_BASE_URL and VITE_INSFORGE_ANON_KEY before sign-up can start.
   133	              </div>
   134	            )}
   135	
   136	            <form onSubmit={(e) => void handleEmailSignup(e)} className="space-y-3">
   137	              <div>
   138	                <label htmlFor="signup-name" className="sr-only">Full name</label>
   139	                <input
   140	                  id="signup-name"
   141	                  type="text"
   142	                  autoComplete="name"
   143	                  placeholder="Full name (optional)"
   144	                  value={name}
   145	                  onChange={(e) => setName(e.target.value)}
   146	                  disabled={submitting}
   147	                  className="w-full rounded-lg border border-surface-300 bg-white px-4 py-3 text-sm text-surface-900 placeholder-surface-400 transition-colors focus:border-accent focus:outline-none focus:ring-2 focus:ring-accent/20 disabled:opacity-60 dark:border-surface-700 dark:bg-surface-900 dark:text-surface-100 dark:placeholder-surface-500 dark:focus:border-accent"
   148	                />
   149	              </div>
   150	              <div>
   151	                <label htmlFor="signup-email" className="sr-only">Email address</label>
   152	                <input
   153	                  id="signup-email"
   154	                  type="email"
   155	                  autoComplete="email"
   156	                  required
   157	                  placeholder="Email address"
   158	                  value={email}
   159	                  onChange={(e) => setEmail(e.target.value)}
   160	                  disabled={submitting}
   161	                  className="w-full rounded-lg border border-surface-300 bg-white px-4 py-3 text-sm text-surface-900 placeholder-surface-400 transition-colors focus:border-accent focus:outline-none focus:ring-2 focus:ring-accent/20 disabled:opacity-60 dark:border-surface-700 dark:bg-surface-900 dark:text-surface-100 dark:placeholder-surface-500 dark:focus:border-accent"
   162	                />
   163	              </div>
   164	              <div>
   165	                <label htmlFor="signup-password" className="sr-only">Password</label>
   166	                <input
   167	                  id="signup-password"
   168	                  type="password"
   169	                  autoComplete="new-password"
   170	                  required
   171	                  minLength={6}
   172	                  placeholder="Password (at least 6 characters)"
   173	                  value={password}
   174	                  onChange={(e) => setPassword(e.target.value)}
   175	                  disabled={submitting}
   176	                  className="w-full rounded-lg border border-surface-300 bg-white px-4 py-3 text-sm text-surface-900 placeholder-surface-400 transition-colors focus:border-accent focus:outline-none focus:ring-2 focus:ring-accent/20 disabled:opacity-60 dark:border-surface-700 dark:bg-surface-900 dark:text-surface-100 dark:placeholder-surface-500 dark:focus:border-accent"
   177	                />
   178	              </div>
   179	              <button
   180	                type="submit"
   181	                disabled={submitting || !email.trim() || password.length < 6}
   182	                className="btn-primary w-full flex items-center justify-center gap-2"
   183	              >
   184	                {submitting ? (
   185	                  <>
   186	                    <span className="inline-block h-4 w-4 rounded-full border-2 border-white border-t-transparent animate-spin" />
   187	                    Creating account…
   188	                  </>
   189	                ) : (
   190	                  'Create account'
   191	                )}
   192	              </button>
   193	            </form>
   194	
   195	            <div className="flex items-center gap-3 py-1" role="separator" aria-orientation="horizontal">
   196	              <span className="flex-1 border-t border-surface-200 dark:border-surface-700" />
   197	              <span className="text-xs text-surface-400">or continue with</span>
   198	              <span className="flex-1 border-t border-surface-200 dark:border-surface-700" />
   199	            </div>
   200	
   201	            {SOCIAL_AUTH_PROVIDERS.map((provider) => (
   202	              <button
   203	                key={provider.id}
   204	                type="button"
   205	                disabled={!isInsForgeConfigured || pendingProvider !== null || submitting}
   206	                onClick={() => void handleSocialSignup(provider.id)}
   207	                className="w-full flex items-center justify-center gap-3 rounded-lg border border-surface-300 bg-white px-4 py-3 text-sm font-semibold text-surface-800 transition-colors hover:bg-surface-50 disabled:cursor-not-allowed disabled:opacity-60 dark:border-surface-700 dark:bg-surface-900 dark:text-surface-100 dark:hover:bg-surface-800"
   208	              >
   209	                <ProviderIcon provider={provider.id} />
   210	                {pendingProvider === provider.id ? `Redirecting to ${provider.shortLabel}...` : provider.label}
   211	              </button>
   212	            ))}
   213	
   214	            {error && (
   215	              <div className="rounded-lg border border-risk-high/30 bg-risk-high/10 px-3 py-2 text-sm text-risk-high">
   216	                {error}
   217	              </div>
   218	            )}
   219	
   220	            <p className="pt-2 text-center text-xs text-surface-400">
   221	              By continuing, you agree to the <Link to="/terms" className="text-accent hover:underline">Terms</Link> and <Link to="/privacy" className="text-accent hover:underline">Privacy Policy</Link>.
   222	            </p>
   223	          </div>
   224	
   225	          <p className="mt-6 text-center text-sm text-surface-500">
   226	            Already have an account?{' '}
   227	            <Link to="/login" className="font-medium text-accent hover:underline">
   228	              Sign in
   229	            </Link>
   230	          </p>
   231	        </section>
   232	      </main>
   233	    </div>
   234	  );
   235	}
   236	
   237	function ProviderIcon({ provider }: { provider: SocialAuthProvider }) {
   238	  if (provider === 'google') {
   239	    return (
   240	      <svg className="h-5 w-5" viewBox="0 0 24 24" aria-hidden="true">
   241	        <path fill="#4285F4" d="M21.6 12.23c0-.74-.07-1.45-.19-2.13H12v4.03h5.38a4.6 4.6 0 0 1-1.99 3.02v2.51h3.23c1.89-1.74 2.98-4.31 2.98-7.43Z" />
