   152	            { label: 'Terms of Service', to: '/terms', desc: 'Legal terms governing use of the platform' },
   153	            { label: 'Data Processing Addendum', to: '/dpa', desc: 'GDPR-compliant DPA for EU customers' },
   154	            { label: 'Contact Security Team', to: '/contact', desc: 'Report vulnerabilities or request a security review' },
