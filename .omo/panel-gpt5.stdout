   158	              <p className="text-xs text-surface-500">{doc.desc}</p>
   159	            </Link>
   160	          ))}
   161	        </div>
   162	      </section>
   163	
   164	      {/* ─── CTA ─── */}
   165	      <section className="max-w-5xl mx-auto px-6 py-14">
   166	        <div className="relative overflow-hidden rounded-2xl bg-gradient-to-br from-brand-600 to-brand-800 dark:from-brand-700 dark:to-brand-900 px-8 py-12 text-center">
   167	          <div className="relative">
   168	            <h2 className="text-xl md:text-2xl font-bold text-white mb-3">Questions about security?</h2>
