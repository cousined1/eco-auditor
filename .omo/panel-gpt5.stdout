   224	}
   225	function BackupIcon() {
   226	  return <svg className="w-5 h-5" viewBox="0 0 20 20" fill="none" stroke="currentColor" strokeWidth="1.5" strokeLinecap="round" strokeLinejoin="round"><path d="M10 3a7 7 0 017 7v1" /><path d="M17 11l-2-2-2 2" /><path d="M10 17a7 7 0 01-7-7V9" /><path d="M3 9l2 2 2-2" /></svg>;
