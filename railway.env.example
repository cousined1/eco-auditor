# Eco-Auditor Railway Environment Variables
# Copy this file as reference when configuring Railway service variables.
# Every name below is declared, with its default, in server-config.cjs (ENV_SCHEMA);
# tests/env-schema-parity.test.ts fails when this file, the schema and the code drift.
# Values here are placeholders: never commit a real one.
#
# Set via: railway variables set KEY=VALUE
# Or via: Railway Dashboard → Service → Variables
#
# VITE_* variables are inlined into the client bundle at BUILD time. The Dockerfile
# declares them with ARG, which is how Railway passes a service variable to a
# Dockerfile build; a VITE_ variable added later needs its own ARG line there.

# ─── Set by Railway (do not set by hand) ───

# Port for the Express server. The server exits at boot without it.
# PORT=3000

# The commit being served; /health and /api/health report it as "sha".
# RAILWAY_GIT_COMMIT_SHA=<commit sha>

# ─── Required ───

# Node environment
NODE_ENV=production

# InsForge backend URL (Vite embeds this at build time; without it sign-in is off)
VITE_INSFORGE_BASE_URL=https://your-insforge-app.up.railway.app

# InsForge anonymous key (Vite embeds this at build time; without it sign-in is off)
VITE_INSFORGE_ANON_KEY=your-insforge-anon-key

# Postgres connection string: the only data store (there is no in-memory stand-in;
# without it every data route answers 503). Production boot HARD-FAILS without
# this whenever InsForge auth is configured (server.cjs startServer) — omitting it
# gives you a crash-looping deploy, not a degraded one.
DATABASE_URL=postgresql://user:password@host:5432/dbname

# Public base URL of the deployed app, no trailing slash. Every Stripe redirect
# is built from it (checkout success/cancel, billing portal return). If unset,
# the server refuses to boot when STRIPE_SECRET_KEY is present — previously it
# silently fell back to http://localhost:3000 and bounced paying customers to a
# dead URL, which also skipped the /api/checkout/verify reconciliation.
APP_URL=https://ecoauditor.io

# Google Tag Manager container ID. Vite inlines it at build time (the Dockerfile
# ARG passes it to the build), so it must be set before the deploy that builds.
VITE_GTM_ID=GTM-XXXXXXX

# ─── Stripe (required for billing) ───

# Stripe publishable key (Vite embeds this at build time)
VITE_STRIPE_PK=pk_live_your_publishable_key

# Stripe secret key (server-side only, not embedded in frontend)
STRIPE_SECRET_KEY=sk_live_your_secret_key

# Stripe webhook signing secret (server-side only)
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret

# Stripe price IDs (server-side only) — checkout is allowlisted against these.
# One per plan x billing interval; all six are required for paid plans.
STRIPE_PRICE_STARTER_MONTHLY=price_your_starter_monthly
STRIPE_PRICE_STARTER_ANNUAL=price_your_starter_annual
STRIPE_PRICE_GROWTH_MONTHLY=price_your_growth_monthly
STRIPE_PRICE_GROWTH_ANNUAL=price_your_growth_annual
STRIPE_PRICE_PRO_MONTHLY=price_your_pro_monthly
STRIPE_PRICE_PRO_ANNUAL=price_your_pro_annual

# The same price IDs under their VITE_ names: the server falls back to these when
# the unprefixed ones are unset (a VITE_-only setup works). Set one form or the
# other; if both are set they must be equal (the server warns at boot otherwise).
# VITE_STRIPE_PRICE_STARTER_MONTHLY=price_your_starter_monthly
# VITE_STRIPE_PRICE_STARTER_ANNUAL=price_your_starter_annual
# VITE_STRIPE_PRICE_GROWTH_MONTHLY=price_your_growth_monthly
# VITE_STRIPE_PRICE_GROWTH_ANNUAL=price_your_growth_annual
# VITE_STRIPE_PRICE_PRO_MONTHLY=price_your_pro_monthly
# VITE_STRIPE_PRICE_PRO_ANNUAL=price_your_pro_annual

# Unprefixed publishable key, served by /api/config/prices when VITE_STRIPE_PK is unset.
# STRIPE_PK=pk_live_your_publishable_key

# ─── Blog publishing (autoblog) ───

# Bearer token of POST /api/publish, which SEO AI Regent uses to publish posts.
# Unset, publishing answers 503 (a production boot with a database logs a warning).
# A secret: generate a long random value and store it in a secret manager.
SITE_DEPLOY_TOKEN=<long-random-token>

# ─── Optional ───

# Canonical origin of the blog pages, sitemap.xml and published posts.
# Default: https://ecoauditor.io
# PUBLIC_ORIGIN=https://ecoauditor.io

# Unprefixed InsForge names. The server reads INSFORGE_BASE_URL first when it
# verifies a session, but /api/insforge-config prefers the VITE_ names, so if
# both forms are set they must be equal (the server warns at boot otherwise).
# INSFORGE_BASE_URL=https://your-insforge-app.up.railway.app
# INSFORGE_ANON_KEY=your-insforge-anon-key

# Secret key for the keyed hash of each visitor's IP address in consent records.
# OWNER ACTION: set it (runtime variable). Production boots without it, because
# refusing to start would take the site down over a hardening variable: the server
# then uses a random per-process value and logs ONE warning at boot, and ip_hash
# values from before and after a restart or redeploy, or from different replicas,
# can no longer be compared, which weakens the consent audit trail.
# Generate once (e.g. node -e "console.log(require('crypto').randomBytes(32).toString('hex'))") and store in a secret manager; never commit a real value.
CONSENT_IP_PEPPER=<pepper>

# Where new leads are announced (Slack-compatible incoming webhook, https only).
# The contact page, demo page and chatbot promise a human follow-up; without this
# a lead is only a row in public.leads and the server logs a warning at boot.
# The server POSTs {"text": "..."} after each lead is stored: 3 second timeout,
# redirects never followed, and a failure never fails the lead request. Treat the
# URL as a secret (anyone who has it can post to the channel); set it in the
# Railway variables tab, never in a committed file.
# LEAD_NOTIFY_WEBHOOK_URL=https://hooks.slack.com/services/<workspace-id>/<channel-id>/<token>

# Send Strict-Transport-Security outside production too (production always does).
# FORCE_HSTS=false

# The commit being served when not on Railway (CI, local runs).
# GIT_SHA=<commit sha>

# Leave unset: /api/version reports package.json's version. An APP_VERSION that is
# not valid semver, or older than package.json, is ignored with a boot warning.
# APP_VERSION=

# ─── Development only: NEVER set these in production ───
# (a production boot logs a warning for each one that is set)

# Accept DEV_AUTH_SECRET as a bearer token for DEV_COMPANY_ID (ignored in production).
# ALLOW_DEV_AUTH=false
# DEV_AUTH_SECRET=<local-only-secret>
# DEV_COMPANY_ID=test-company-1
