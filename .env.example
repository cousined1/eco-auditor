# =============================================================================
# Eco-Auditor — Required Environment Variables
# =============================================================================
# Copy this file to .env for local development.
# In Railway: set each variable under your service's "Variables" tab.
# Values must NOT be quoted in Railway's variable editor.
# =============================================================================

# -----------------------------------------------------------------------------
# Google Tag Manager (optional)
# -----------------------------------------------------------------------------
# Your GTM container ID (e.g., GTM-XXXXXX)
# Leave empty to disable GTM
# NOTE: Vite inlines this at build time. For the Docker/Railway deploy it must
# also be declared as a build ARG (Dockerfile + railway.toml) — a runtime-only
# environment variable leaves GTM disabled in the shipped bundle.
VITE_GTM_ID=GTM-XXXXXXX

# -----------------------------------------------------------------------------
# Public base URL (required in production when Stripe is configured)
# -----------------------------------------------------------------------------
# No trailing slash. Used to build every Stripe redirect (checkout success and
# cancel, billing portal return). Production boot fails without it when
# STRIPE_SECRET_KEY is set, so paying customers are never sent to localhost.
APP_URL=http://localhost:3000

# -----------------------------------------------------------------------------
# InsForge Backend (required)
# Find these in your InsForge project dashboard → Settings → API
# -----------------------------------------------------------------------------

# Postgres connection string for the InsForge project's database. The server
# boot fails in production when this is missing (InsForge auth configured but
# no database reachable).
DATABASE_URL=postgres://user:password@host:5432/your-project

# Your InsForge project's base URL (no trailing slash)
VITE_INSFORGE_BASE_URL=https://your-project.region.insforge.app

# InsForge anonymous (public) API key — safe to expose to the browser
VITE_INSFORGE_ANON_KEY=ik_your_anon_key_here

# -----------------------------------------------------------------------------
# Consent audit trail (server-side; recommended in production)
# -----------------------------------------------------------------------------
# Generate once (e.g. node -e "console.log(require('crypto').randomBytes(32).toString('hex'))") and store in a secret manager; never commit a real value here.
CONSENT_IP_PEPPER=<pepper>

# -----------------------------------------------------------------------------
# Notes
# -----------------------------------------------------------------------------
# • All VITE_* variables are inlined into the client bundle at build time by
#   Vite.  Do NOT store server-side secrets here.
# • The InsForge anon key is designed to be public — Row Level Security (RLS)
#   policies on the backend enforce data access boundaries.
# • If you add a service-role key for server-side operations, store it as a
#   non-VITE_ variable and access it only from secure server-side code.

# -----------------------------------------------------------------------------
# Stripe Billing (required for paid plans)
# Create products/prices in the Stripe dashboard, then set each value below.
# -----------------------------------------------------------------------------

# Stripe publishable key (safe to expose; inlined into the client bundle)
VITE_STRIPE_PK=pk_live_your_publishable_key

# Stripe secret key (server-side ONLY — never prefix with VITE_)
STRIPE_SECRET_KEY=sk_live_your_secret_key

# Stripe webhook signing secret (server-side only)
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret

# -----------------------------------------------------------------------------
# Microsoft Entra External ID — "Sign in with Microsoft" (reference only)
# -----------------------------------------------------------------------------
# The app does NOT read these variables: the OAuth code exchange happens inside
# InsForge, which holds the client secret (Dashboard → Auth → Custom OAuth,
# provider key "microsoft"). They are recorded here so the Entra configuration
# is documented next to the rest of the environment.
# NEVER put ENTRA_CLIENT_SECRET in this repo — it lives only in InsForge.
ENTRA_TENANT_SUBDOMAIN=your-tenant-subdomain
ENTRA_CLIENT_ID=00000000-0000-0000-0000-000000000000
ENTRA_REDIRECT_URI=https://your-project.region.insforge.app/api/auth/oauth/custom/entra/callback

# Stripe price IDs — one per plan x billing interval (server-side only).
# The server (server.cjs / server-billing.cjs) allowlists checkout against
# these; without them paid checkout cannot run.
STRIPE_PRICE_STARTER_MONTHLY=price_your_starter_monthly
STRIPE_PRICE_STARTER_ANNUAL=price_your_starter_annual
STRIPE_PRICE_GROWTH_MONTHLY=price_your_growth_monthly
STRIPE_PRICE_GROWTH_ANNUAL=price_your_growth_annual
STRIPE_PRICE_PRO_MONTHLY=price_your_pro_monthly
STRIPE_PRICE_PRO_ANNUAL=price_your_pro_annual
